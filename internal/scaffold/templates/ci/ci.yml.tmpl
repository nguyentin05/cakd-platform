name: CI Pipeline
on:
  push:
    branches: [main]

env:
  REGISTRY: ghcr.io

jobs:
[[ range .Services ]]
  build-[[ .Name ]]:
    runs-on: ubuntu-latest
    permissions:
      contents: write
      packages: write

    steps:
      - uses: actions/checkout@v4

      - name: Set up JDK
        uses: actions/setup-java@v4
        with:
          java-version: '[[ if .LanguageVersion ]][[ .LanguageVersion ]][[ else ]]21[[ end ]]'
          distribution: 'temurin'

[[ if eq .ProjectBuild "gradle-project" "gradle-project-kotlin" ]]
      - name: Build with Gradle
        run: cd services/[[ .Name ]] && ./gradlew clean build -x test

      - name: Run Tests
        run: cd services/[[ .Name ]] && ./gradlew test
[[ else ]]
      - name: Build with Maven
        run: cd services/[[ .Name ]] && mvn clean package -DskipTests

      - name: Run Tests
        run: cd services/[[ .Name ]] && mvn test
[[ end ]]

      - name: Log in to the Container registry
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build and push Docker image
        uses: docker/build-push-action@v5
        with:
          context: services/[[ .Name ]]
          push: true
          tags: ${{ env.REGISTRY }}/[[ $.Metadata.Owner ]]/[[ .Name ]]:${{ github.sha }}
          labels: |
            org.opencontainers.image.source=https://github.com/${{ github.repository }}

      - name: Update Helm Values
        run: |
          sed -i "s/tag: .*/tag: \"${{ github.sha }}\"/g" services/[[ .Name ]]/helm/values.yaml
          
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git commit -am "chore: update image tag for [[ .Name ]] to ${{ github.sha }}" || echo "No changes to commit"
          git push || echo "Push failed or already up to date"
[[ end ]]
