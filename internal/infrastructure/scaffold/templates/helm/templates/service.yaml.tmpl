apiVersion: v1
kind: Service
metadata:
  name: {{ .Release.Name }}-[[ .Service.Name ]]
  labels:
    app.kubernetes.io/name: [[ .Service.Name ]]
    app.kubernetes.io/instance: {{ .Release.Name }}
spec:
  type: {{ .Values.service.type }}
  ports:
    - port: {{ .Values.service.port }}
      targetPort: http
      protocol: TCP
      name: http
  selector:
    app.kubernetes.io/name: [[ .Service.Name ]]
    app.kubernetes.io/instance: {{ .Release.Name }}
