apiVersion: v2
name: [[ .Metadata.Name ]]
description: A Helm chart for Kubernetes
type: application
version: 0.1.0
appVersion: "1.0"
[[ if .Spec.Dependencies.Database ]]
dependencies:
  - name: postgresql
    version: "15.x.x"
    repository: https://charts.bitnami.com/bitnami
    condition: postgresql.enabled
[[ end ]]
